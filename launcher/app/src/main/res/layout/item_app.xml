<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="116dp" android:paddingStart="12dp" android:paddingEnd="12dp"
    android:clipChildren="false" android:clipToPadding="false">
    <FrameLayout android:id="@+id/card" android:layout_width="match_parent" android:layout_height="match_parent"
        android:focusable="true" android:clickable="true" android:background="@android:color/transparent">
        <ImageView android:id="@+id/mark" android:layout_width="154dp" android:layout_height="64dp"
            android:layout_gravity="top|center_horizontal" android:layout_marginTop="12dp" android:scaleType="fitCenter"
            android:contentDescription="@null" />
        <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="22dp"
            android:layout_gravity="bottom" android:layout_marginBottom="7dp" android:gravity="center"
            android:textSize="12sp" android:textColor="#8C919A" android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 500" android:singleLine="true" android:ellipsize="end" />
    </FrameLayout>
</FrameLayout>
