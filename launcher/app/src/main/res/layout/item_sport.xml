<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
    android:layout_marginEnd="8dp" android:paddingStart="0dp" android:paddingEnd="16dp"
    android:paddingTop="8dp" android:paddingBottom="8dp" android:orientation="vertical">
    <TextView android:id="@+id/team" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#9297A2" android:textSize="10sp" android:fontFamily="@font/inter" android:singleLine="true" android:ellipsize="end" />
    <TextView android:id="@+id/matchup" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:textColor="#E4E6EB" android:textSize="14sp" android:fontFamily="@font/inter"
        android:fontVariationSettings="'wght' 600" android:singleLine="true" android:ellipsize="end" />
    <TextView android:id="@+id/when" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:textColor="#9297A2" android:textSize="10sp" android:fontFamily="@font/inter"
        android:singleLine="true" android:ellipsize="end" />
</LinearLayout>
