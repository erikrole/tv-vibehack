<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.google.android.youtube.tvunplugged</item>
        <item>com.google.android.youtube.tv</item>
        <item>com.apple.atve.androidtv.appletv</item>
        <item>com.netflix.ninja</item>
    </string-array>

    <!-- Order of the app grid below the dock, top to bottom. Anything not listed follows alphabetically. -->
    <string-array name="grid_apps">
        <item>com.hulu.livingroomplus</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>com.peacocktv.peacockandroid</item>
        <item>com.bamnetworks.mobile.android.gameday.atbat</item>
        <item>com.jamdeo.tv.mediacenter</item>
        <item>com.android.vending</item>
        <item>com.android.tv.settings</item>
    </string-array>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
        <item>com.mediatek.wwtv.tvcenter</item>
        <item>com.mitv.gallery</item>
        <item>com.hisense.tv.protector</item>   <!-- Device Assistant -->
        <item>com.mediatek.androidbox</item>   <!-- Screen Sharing -->
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false">com.mediatek.wwtv.tvcenter</string>

    <!-- Shown instead of the time-of-day greeting top left. Leave empty to show "Good morning" etc. -->
    <string name="room_name" translatable="false">Basement Home Theater</string>

    <!-- Tiles per row in the grid; the dock always has this many slots. -->
    <integer name="columns">4</integer>

    <!-- Home Assistant scene row. Entity ids and labels, in order. Needs ha.url and ha.token in launcher/local.properties. -->
    <string-array name="ha_scene_ids">
        <item>scene.good_morning</item>
        <item>scene.workout</item>
        <item>scene.bedtime</item>
    </string-array>
    <string-array name="ha_scene_labels">
        <item>Morning</item>
        <item>Workout</item>
        <item>Bedtime</item>
    </string-array>

    <!-- The TV in Home Assistant, used by the sleep timer (media_player.turn_off). -->
    <string name="ha_tv_entity" translatable="false">media_player.home_theater_hisense_tv</string>

    <!-- ESPN team schedules checked for the Badgers card; the earliest upcoming game wins. Team id 275 = Wisconsin. -->
    <string-array name="badgers_schedules">
        <item>football/college-football</item>
        <item>basketball/mens-college-basketball</item>
        <item>basketball/womens-college-basketball</item>
        <item>hockey/mens-college-hockey</item>
    </string-array>
    <string name="badgers_team_id" translatable="false">275</string>
</resources>
